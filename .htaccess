# Don't advertise the Apache version on error pages
ServerSignature Off

RewriteEngine On

# Static site: only reading methods are allowed. POST/PUT/DELETE/TRACE etc. get 405.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS)$
RewriteRule ^ - [R=405,L]

# Internal folders are never part of the public site, even if copied up by mistake
RewriteRule ^(tools|_originals_backup|repositories|\.git)(/|$) - [F,L]

# Force HTTPS and drop the www prefix
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://optiononeagencies.com%{REQUEST_URI} [L,R=301]

# Clean URLs: /index.html -> /, /about.html -> /about
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]
# ...and serve /about from about.html behind the scenes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

DirectoryIndex index.html
Options -Indexes

# Security headers
<IfModule mod_headers.c>
  # HTTPS only, for this domain and every subdomain (all are covered by the wildcard certificate)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  # No other site may put these pages inside a frame (clickjacking)
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), browsing-topics=()"
  # Isolate the site's window and files from other sites
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always unset X-Powered-By
  # Only this site's own scripts run (no inline script); the outside sources
  # are Google Fonts and the Google Maps embed on the contact page. Inline
  # styles stay allowed because the pages use style="" attributes.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; worker-src 'none'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
</IfModule>

# Never serve dotfiles, repo config, backups, archives or server-side scripts.
# The site has no PHP or other server code, so anything like that is unwanted.
<FilesMatch "^\.|~$|\.(yml|yaml|md|bak|old|orig|swp|tmp|log|sql|zip|tar|gz|rar|7z|ini|conf|env|py|sh|php[0-9]?|phtml|phar|pl|cgi|asp|aspx|jsp)$">
  Require all denied
</FilesMatch>

# Browser caching
# Pages link to assets as file.ext?v=<content hash> (see tools/version-assets.py),
# so an asset's URL changes whenever the file does. Those URLs can be cached for
# a year; pages themselves are always revalidated so visitors see updates at once.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  Header unset Expires
  # Pages: check with the server on every visit (cheap 304 when unchanged)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Unversioned assets (e.g. images picked by main.js, favicons, share images): short cache
  <FilesMatch "\.(css|js|webp|jpe?g|png|gif|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Versioned assets: the URL changes with the content, so cache long and never revalidate
  <If "%{QUERY_STRING} =~ /(^|&)v=[0-9a-f]+/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
