# Force HTTPS and drop the www prefix
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://optiononeagencies.com%{REQUEST_URI} [L,R=301]

# Clean URLs: /index.html -> /, /about.html -> /about
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]
# ...and serve /about from about.html behind the scenes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

DirectoryIndex index.html
Options -Indexes

# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests; object-src 'none'; base-uri 'self'"
</IfModule>

# Never serve dotfiles, repo config or backups
<FilesMatch "^\.|\.(yml|yaml|md|bak|log|sql|zip|ini|py)$">
  Require all denied
</FilesMatch>

# Browser caching
# Pages link to assets as file.ext?v=<content hash> (see tools/version-assets.py),
# so an asset's URL changes whenever the file does. Those URLs can be cached for
# a year; pages themselves are always revalidated so visitors see updates at once.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  Header unset Expires
  # Pages: check with the server on every visit (cheap 304 when unchanged)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Unversioned assets (e.g. images picked by main.js, favicons, share images): short cache
  <FilesMatch "\.(css|js|webp|jpe?g|png|gif|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Versioned assets: the URL changes with the content, so cache long and never revalidate
  <If "%{QUERY_STRING} =~ /(^|&)v=[0-9a-f]+/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
